<title>What it costs to run the monasteries</title>
<meta name="claude:viewport-fit-sides" content="cover">
<meta name="robots" content="noindex, nofollow">
<style>
/* Same look as the Sangha community list statistics: one column of cards, charts drawn as plain SVG. */
:root {
  color-scheme: light;
  --page: #f9f9f7; --surface: #fcfcfb; --ink: #0b0b0b; --ink-2: #52514e; --muted: #898781;
  --grid: #e1e0d9; --axis: #c3c2b7; --ring: rgba(11,11,11,0.10);
  --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100; --s5: #e87ba4; --s6: #008300; --s7: #6250d6; --s8: #e34948; --s9: #7d7a70;
  --critical: #d03b3b; --good: #006300; --on-slice: #ffffff;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    color-scheme: dark;
    --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
    --grid: #2c2c2a; --axis: #383835; --ring: rgba(255,255,255,0.10);
    --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --s5: #d55181; --s6: #008300; --s7: #9085e9; --s8: #e66767; --s9: #9a978d;
    --critical: #e66767; --good: #0ca30c;
  }
}
:root[data-theme="dark"] {
  color-scheme: dark;
  --page: #0d0d0d; --surface: #1a1a19; --ink: #f0efec; --ink-2: #c3c2b7; --muted: #898781;
  --grid: #2c2c2a; --axis: #383835; --ring: rgba(255,255,255,0.10);
  --s1: #3987e5; --s2: #d95926; --s3: #199e70; --s4: #c98500; --s5: #d55181; --s6: #008300; --s7: #9085e9; --s8: #e66767; --s9: #9a978d;
  --critical: #e66767; --good: #0ca30c;
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--page); color: var(--ink); font: 15px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
main { max-width: 1060px; margin: 0 auto; padding-block: 32px 64px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
header h1 { font-size: 28px; line-height: 1.2; margin: 0 0 6px; letter-spacing: -0.01em; text-wrap: balance; }
header p { margin: 0 0 6px; color: var(--ink-2); max-width: 760px; }
.tag { display: inline-block; font-size: 12px; color: var(--ink-2); border: 1px solid var(--ring); border-radius: 999px; padding: 2px 10px; margin-top: 6px; }
.toc { margin: 16px 0 4px; }
.toc ol { list-style: none; padding: 0; margin: 0; }
.toc li { margin: 0 0 4px; }
.toc a, .backtop a, a { color: var(--s1); text-decoration: none; }
.toc a:hover, .backtop a:hover, a:hover { text-decoration: underline; }
a:focus-visible, summary:focus-visible { outline: 2px solid var(--s1); outline-offset: 2px; }
.backtop { margin: 10px 0 0; text-align: right; font-size: 13px; }
section { margin-top: 64px; padding-top: 16px; border-top: 1px solid var(--ring); scroll-margin-top: 12px; }
section > h2 { font-size: 22px; margin: 0 0 6px; text-wrap: balance; }
section > p.lede { margin: 0 0 16px; color: var(--ink-2); max-width: 760px; }
.card { background: var(--surface); border: 1px solid var(--ring); border-radius: 12px; padding: 18px 18px 14px; margin-bottom: 16px; overflow-x: auto; min-width: 0; }
.card h3 { font-size: 15px; margin: 0 0 2px; }
.card .sub { font-size: 13px; color: var(--ink-2); margin: 0 0 12px; }
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
.grid2 > .card { margin-bottom: 0; }
@media (max-width: 760px) { .grid2 { grid-template-columns: 1fr; } }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-top: 22px; }
.tile { background: var(--surface); border: 1px solid var(--ring); border-radius: 12px; padding: 14px 16px; }
.tile .v { font-size: 26px; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; }
.tile .l { font-size: 13px; color: var(--ink-2); margin-top: 4px; }
.tile .c { font-size: 12px; color: var(--muted); margin-top: 2px; }
.quote { margin: 4px 0 12px; padding: 8px 12px; border-left: 3px solid var(--s2); color: var(--ink-2); font-size: 13.5px; font-style: italic; }
.quote cite { display: block; font-style: normal; font-size: 12px; color: var(--muted); margin-top: 4px; }
.under { font-size: 13px; color: var(--ink-2); margin: 6px 0 0; font-variant-numeric: tabular-nums; }
.bridge .hb { font-size: 14px; }
.bridge .hb.b { font-weight: 600; }
.bridge .hb-t { position: relative; background: transparent; overflow: visible; height: 16px; }
.bridge .hb-t i { position: absolute; top: 0; }
.bridge .hb-t b { position: absolute; top: -4px; bottom: -4px; width: 0; border-left: 1.5px solid var(--ink-2); }
.bridge .hb-v { min-width: 4.5em; }
.bridge hr { border: 0; border-top: 1px solid var(--grid); margin: 2px 0; width: 100%; }
.latest { margin: 18px 0 0; max-width: 760px; }
.legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 12.5px; color: var(--ink-2); margin: 0 0 8px; }
.legend span { display: inline-flex; align-items: center; gap: 6px; }
.legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
.legend i.line { height: 2px; width: 14px; border-radius: 1px; }
.legend i.line.dash { height: 0; width: 18px; background: none; border-top: 2px dashed; border-radius: 0; }
svg { display: block; width: 100%; height: auto; overflow: visible; }
svg text { fill: var(--muted); font-size: 12px; font-family: inherit; }
svg .lbl { fill: var(--ink-2); font-size: 12.5px; }
svg .lbl.in { fill: var(--on-slice); font-weight: 600; }
svg .gl { stroke: var(--grid); stroke-width: 1; }
svg .base { stroke: var(--axis); stroke-width: 1; }
.note { font-size: 13px; color: var(--ink-2); margin: 10px 0 0; max-width: 760px; }
table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
th { text-align: left; font-weight: 600; color: var(--ink-2); font-size: 12px; border-bottom: 1px solid var(--axis); padding: 6px 8px; }
td { border-bottom: 1px solid var(--grid); padding: 6px 8px; vertical-align: top; }
td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
tr.tot td { font-weight: 600; border-top: 1px solid var(--axis); }
tr.grp td { color: var(--ink-2); font-size: 12px; font-weight: 600; padding-top: 14px; }
td.sub1 { padding-left: 20px; }
.good { color: var(--good); } .bad { color: var(--critical); }
details { margin-top: 10px; overflow: hidden; }
summary { cursor: pointer; color: var(--ink-2); font-size: 13.5px; }
.kinds.one { grid-template-columns: 1fr; gap: 28px; }
.kinds { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px 22px; }
.kind h4 { font-size: 13.5px; margin: 0; }
.kind .ch { font-size: 12.5px; color: var(--ink-2); margin: 0 0 4px; font-variant-numeric: tabular-nums; }
.toggle { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 14px; }
.toggle-note { font-size: 12.5px; color: var(--ink-2); }
button.pill { font: inherit; font-size: 13px; color: var(--ink); cursor: pointer; padding: 4px 12px; border-radius: 999px; border: 1px solid var(--ring); background: var(--page); }
button.pill:hover { border-color: var(--ink-2); }
button.pill[aria-pressed="true"] { border-color: var(--s1); background: var(--surface); font-weight: 600; }
button.pill:focus-visible { outline: 2px solid var(--s1); outline-offset: 2px; }
h3.then { font-size: 14px; font-weight: 600; color: var(--ink-2); margin: 4px 0 0; }
.tiles-small { margin: 10px 0 16px; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
.tiles-small .tile.up .v { color: var(--critical); }
.scroll-x { overflow-x: auto; }
#t-all th:first-child, #t-all td:first-child { position: sticky; left: 0; background: var(--surface); z-index: 1; box-shadow: 1px 0 0 var(--ring); }
.swipe { display: none; font-size: 13px; color: var(--muted); margin: 0 0 6px; }
@media (max-width: 760px) { .swipe { display: block; } }
.hbars { display: grid; gap: 8px; }
.hb { display: grid; grid-template-columns: minmax(120px, 15em) 1fr auto; gap: 10px; align-items: center; font-size: 13.5px; }
.hb-t { background: var(--grid); border-radius: 4px; height: 14px; overflow: hidden; }
.hb-t i { display: block; height: 100%; border-radius: 4px; }
.hb-v { font-variant-numeric: tabular-nums; white-space: nowrap; min-width: 6.5em; text-align: right; }
.hb-p { color: var(--muted); font-size: 12px; }
@media (max-width: 520px) { .hb { grid-template-columns: 1fr auto; } .hb-t { grid-column: 1 / -1; grid-row: 2; } }
.sources { font-size: 14px; }
.prices { margin: -6px 0 16px; }
.then-row { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: baseline; justify-content: space-between; }
.picker { font-size: 13.5px; color: var(--ink-2); display: inline-flex; gap: 8px; align-items: center; }
.picker select { font: inherit; font-size: 13.5px; padding: 4px 8px; border-radius: 8px; border: 1px solid var(--ring); background: var(--surface); color: var(--ink); }
.picker select:focus-visible { outline: 2px solid var(--s1); outline-offset: 2px; }
.tile.ref { background: transparent; border-style: dashed; }
.tiles-small .tile .l { font-weight: 600; color: var(--ink); margin: 0 0 4px; }
.row2 { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.row2 .k { font-size: 12.5px; color: var(--ink-2); }
.row2 .v2 { font-size: 22px; font-weight: 600; font-variant-numeric: tabular-nums; }
.row2 .v2.bad { color: var(--critical); }
.row2.pp { margin-top: 8px; padding-top: 6px; border-top: 1px solid var(--ring); }
.compare { margin: 8px 0 10px; }
.explain { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--ring); max-width: 760px; }
.explain h4 { font-size: 14px; margin: 0 0 4px; }
.explain p { font-size: 13.5px; color: var(--ink-2); margin: 6px 0; }
table.rates { width: auto; font-size: 13.5px; margin: 6px 0; }
table.rates td { padding: 4px 12px 4px 0; border-bottom: 1px solid var(--grid); }
.pp-top { margin: 0 0 12px; font-size: 14px; }
.card.feature { border-color: var(--axis); }
.card .big { font-size: 17px; margin: 4px 0 10px; }
.card .big .bad { color: var(--critical); }
.kind .ch .bad { font-weight: 600; }
.kicker { font-size: 13px; color: var(--ink-2); margin: 0 0 6px; letter-spacing: .02em; }
header h1 { font-size: 30px; }
.hero { font-size: 19px; line-height: 1.45; color: var(--ink); max-width: 760px; margin: 10px 0 0; }
.hero b { font-weight: 650; }
.tiles.headline { margin-top: 18px; grid-template-columns: repeat(4, 1fr); }
@media (max-width: 760px) { .tiles.headline { grid-template-columns: 1fr 1fr; gap: 10px; } .tiles.headline .tile { padding: 12px; } }
.tiles.headline .v { font-size: 30px; }
.tiles.headline .v.bad { color: var(--critical); }
.foot { font-size: 12.5px; color: var(--muted); margin: 8px 0 0; }
section.story { margin-top: 28px; padding-top: 0; border-top: 0; }
.caption { font-size: 14.5px; color: var(--ink); margin: 10px 0 0; max-width: 60ch; }
details.how { margin-top: 8px; font-size: 13.5px; color: var(--ink-2); max-width: 65ch; }
details.how summary { cursor: pointer; color: var(--s1); font-size: 13.5px; }
details.how p { margin: 6px 0; }
.meaning { background: var(--surface); border: 1px solid var(--axis); border-radius: 12px; padding: 16px 18px; margin: 4px 0 16px; max-width: 820px; }
.meaning h3 { font-size: 16px; margin: 0 0 6px; }
.meaning p { margin: 0; font-size: 15.5px; }
.defs { font-size: 13px; color: var(--ink-2); max-width: 820px; }
.toc-h { font-size: 13px; font-weight: 600; color: var(--ink-2); margin: 0 0 6px; }
details.more { margin-top: 6px; }
details.more > summary { display: inline-block; list-style: none; cursor: pointer; font-size: 14px; color: var(--s1); border: 1px solid var(--ring); border-radius: 999px; padding: 5px 14px; margin-bottom: 14px; background: var(--surface); }
details.more > summary::-webkit-details-marker { display: none; }
details.more[open] > summary { color: var(--ink-2); }
details.more[open] > summary::after { content: ' (hide)'; }
table.fut { width: auto; margin-top: 12px; }
.explain ul { padding-left: 18px; margin: 6px 0; font-size: 13.5px; color: var(--ink-2); max-width: 760px; }
.tbl-h { font-size: 15px; margin: 18px 0 8px; }
@media (max-width: 520px) { header h1 { font-size: 24px; } .hero { font-size: 17px; } .tiles.headline .v { font-size: 24px; } }
.pies { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px 24px; }
.pie h4 { font-size: 15px; margin: 0 0 6px; text-align: center; }
.pie-svg { max-width: 380px; margin: 0 auto; }
@media (max-width: 520px) { .pie-svg { max-width: 300px; } }
.grp-tbl { margin-top: 12px; }
.grp-tbl td { vertical-align: top; }
.grp-tbl td:first-child { white-space: nowrap; padding-right: 14px; }
.sw { display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; }
svg text.pie-in { fill: var(--on-slice); font-size: 12.5px; font-weight: 600; }
svg text.pie-in.amt { font-size: 12.5px; font-weight: 500; }
svg text.pie-out.amt { fill: var(--ink); font-weight: 600; }
svg text.pie-out { fill: var(--ink-2); font-size: 12px; }
svg text.sub-l { fill: var(--ink-2); font-size: 12px; }
svg text.band-l { fill: var(--ink-2); font-size: 12px; }
.pie-tot { text-align: center; margin: 6px 0 8px; font-size: 14px; font-variant-numeric: tabular-nums; }
.pie-tot b { font-size: 20px; }
.pie-tot span { color: var(--ink-2); font-size: 12.5px; }
.pie ul { list-style: none; padding: 0; margin: 0; font-size: 13px; }
.pie li { display: grid; grid-template-columns: 12px 1fr auto 3.2em; gap: 6px; align-items: center; padding: 2px 0; border-bottom: 1px solid var(--grid); }
.pie li i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }
.pie li b { font-weight: 600; font-variant-numeric: tabular-nums; }
.pie li em { font-style: normal; color: var(--muted); text-align: right; font-variant-numeric: tabular-nums; }
.method p, .method li { max-width: 760px; color: var(--ink-2); font-size: 14px; }
.method ul { padding-left: 20px; }
#tip { position: fixed; pointer-events: none; background: var(--surface); color: var(--ink); border: 1px solid var(--ring); border-radius: 8px; padding: 7px 10px; font-size: 12.5px; box-shadow: 0 4px 16px rgba(0,0,0,.12); z-index: 10; max-width: 280px; }
#tip b { display: block; margin-bottom: 2px; }
#tip .row { display: flex; gap: 10px; align-items: center; justify-content: space-between; }
#tip .row i { width: 8px; height: 8px; border-radius: 2px; display: inline-block; margin-right: 6px; }
@media (max-width: 520px) { td, th { padding: 6px 4px; } .tile .v { font-size: 22px; } }

.missing { margin: 28px 0 0; max-width: 820px; }
.missing h3 { font-size: 15px; margin: 0 0 4px; }
.missing ul { margin: 6px 0 0; padding-left: 18px; }
.missing li { margin: 0 0 4px; }
.place .src { font-size: 12.5px; color: var(--ink-2); margin: 10px 0 0; }
.more-h { font-size: 20px; margin: 40px 0 4px; }
.more-n { max-width: 760px; margin: 0 0 6px; }
.places { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; margin-top: 22px; }
.place { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--ring); border-radius: 12px; padding: 18px 18px 16px; }
.place h2 { font-size: 20px; margin: 0 0 2px; }
.place .where { font-size: 13px; color: var(--ink-2); margin: 0 0 14px; }
.place .big { font-size: 34px; font-weight: 600; line-height: 1.1; font-variant-numeric: tabular-nums; margin: 0; }
.place .bigl { font-size: 13px; color: var(--ink-2); margin: 2px 0 12px; }
.place dl { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; margin: 0 0 12px; font-size: 14px; }
.place dt { color: var(--ink-2); } .place dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
.place .says { font-size: 14.5px; margin: 0 0 14px; flex: 1; }
.place a.go { display: inline-block; align-self: flex-start; font-size: 14px; border: 1px solid var(--ring); border-radius: 999px; padding: 6px 16px; background: var(--page); }
.place a.go:hover { border-color: var(--ink-2); text-decoration: none; }
.place .bar { height: 5px; border-radius: 3px; margin: 0 0 14px; }
.since { font-size: 13.5px; margin: 0 0 6px; color: var(--ink-2); }
.since b { color: var(--ink); font-weight: 600; }
.place .says { margin-bottom: 10px; }
.place .since:last-of-type { margin-bottom: 14px; }
.back { font-size: 13px; margin: 0 0 14px; }

.jump { margin: 16px 0 6px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--ring); border-radius: 12px; }
.jump-h { margin: 0 0 8px; font-size: 13px; font-weight: 600; color: var(--ink-2); text-transform: uppercase; letter-spacing: .04em; }
.jump-r { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding: 7px 0; border-top: 1px solid var(--ring); }
.jump-r:first-of-type { border-top: 0; }
.jump-reg { font-weight: 600; font-size: 15px; margin-right: 4px; }
.jump-p { font-size: 14px; padding: 5px 12px; border: 1px solid var(--ring); border-radius: 999px; background: var(--page); }
.jump a:hover { text-decoration: none; border-color: var(--ink-2); }
.region, .missing, #how { scroll-margin-top: 12px; }
.place { scroll-margin-top: 56px; }
.region > h2.more-h { position: sticky; top: 0; z-index: 5; background: var(--page); margin: 0; padding: 10px 0; border-bottom: 1px solid var(--ring); }
.totop { position: fixed; right: 14px; bottom: calc(14px + env(safe-area-inset-bottom)); z-index: 20; display: none; padding: 9px 14px; font-size: 14px; border: 1px solid var(--ring); border-radius: 999px; background: var(--surface); box-shadow: 0 2px 8px rgba(0,0,0,.15); }
body.scrolled .totop { display: block; }
.totop:hover { text-decoration: none; }
</style>



.place .kind { display: inline-block; font-size: 11.5px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; border-radius: 999px; padding: 2px 10px; margin: 0 0 8px; }
.place .kind-run { background: var(--ink); color: var(--surface); }
.place .kind-total { background: transparent; color: var(--ink-2); border: 1px dashed var(--ink-2); }
.place .big.tot { color: var(--ink-2); font-weight: 400; }
.place .kind { display: block; width: fit-content; margin: 10px 0 4px; }
.place a.go { margin-top: auto; }
.place dl, .place .says, .place .bigl { flex: 0 0 auto; }
.place .says { flex: 0 0 auto; }
.place dl:last-of-type, .place .says:last-of-type { margin-bottom: 16px; }
